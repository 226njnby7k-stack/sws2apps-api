# External sws2apps directory — only used when SELF_HOSTED is not 'true' (M5.5).
# A fully self-hosted instance ignores these and needs neither.
APP_COUNTRY_API=https://collect-api.sws2apps.com/api/countries?
APP_CONGREGATION_API=https://collect-api.sws2apps.com/api/congregations?

# M6: Firebase/Firestore fully removed — no firebase-admin, no Google config,
# no emulator hosts. (The old FIREBASE_*/FIRESTORE_*/GOOGLE_CONFIG_BASE64 vars
# are gone.)

# Passwordless login needs SMTP. When false, the login link/OTP is only returned
# in the HTTP response in DEVELOPMENT; in production the endpoint fails closed
# (it will NOT leak a login code). Configure real mail for a production deploy.
MAIL_ENABLED=false
# SMTP transport. MAIL_HOST is REQUIRED when MAIL_ENABLED=true — the server fails
# to boot otherwise (no Gmail/Google default, per §2 / M6). Use any provider's SMTP
# server. MAIL_PORT 587 = STARTTLS, 465 = implicit TLS. MAIL_ADDRESS is both the
# SMTP username and the From address; MAIL_SENDER_NAME is the display name.
MAIL_HOST=
MAIL_PORT=587
MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_SENDER_NAME=Organized

# REQUIRED. Protects all data at rest AND signs the visitorid session cookie.
# The server fails to boot if unset. Generate a long random value and keep it
# secret — do NOT reuse this example, and never commit the real one:
#   openssl rand -base64 48
SEC_ENCRYPT_KEY=CHANGE_ME_run_openssl_rand_base64_48
STORAGE_PATH=./storage

# Optional: send visitor IPs to third-party geo-IP providers for the session
# "location" display. OFF by default (privacy / EU residency — see PROJECT.md §2).
# When enabled it is best-effort and never blocks login. Set to 'true' to opt in.
IP_GEOLOCATION_ENABLED=false

# M5.5: fully self-hosted mode. When 'true', the API does NOT call the external
# sws2apps directory (APP_COUNTRY_API / APP_CONGREGATION_API): countries come from
# a bundled static list, directory search is disabled, and congregations are
# created from user-entered details (admin sets meeting times/circuit/location in
# settings afterwards). Leave 'false' to keep upstream directory-gated behaviour.
SELF_HOSTED=false

# M5: minimum supported client version (was Firestore api_settings_v3)
MINIMUM_APP_VERSION=1.0.0

# M4: canonical app origin used to build passwordless login-email links. The
# request Origin header is NOT trusted for this (attacker-controllable); set this
# to your deployed client URL. In dev, localhost origins are also accepted.
APP_ORIGIN=http://localhost:4051

# M4: EdDSA (Ed25519) keys for signing/verifying access JWTs. Generate with:
#   openssl genpkey -algorithm ed25519 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
# then embed with newlines escaped as \n (awk 'BEGIN{ORS="\\n"} 1' jwt_*.pem).
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ============================================================================
# M7 — production deploy (docker-compose.yml). Not needed for local dev.
# ============================================================================

# Your domain. Caddy gets automatic TLS for it; the client + API are same-origin
# under it (so COOKIE_SAMESITE=lax is safe — Caddy sets this in compose).
DOMAIN=organized.yourcongregation.example

# Session cookie SameSite. 'lax' for a same-origin Caddy deploy (CSRF defence);
# 'none' only if the client is served from a DIFFERENT origin than the API.
COOKIE_SAMESITE=lax

# --- Backups (see BACKUP.md — run the restore drill before go-live) ---
# age PUBLIC key only. Generate off-box: `age-keygen -o backup-identity.txt`
# (prints "Public key: age1..."). The PRIVATE key file never touches this server —
# store it in a password manager + a second offline location. Losing it = backups
# unrecoverable; leaking it alone reveals nothing (it can't decrypt on its own).
BACKUP_ENCRYPTION_KEY=age1...
# rclone remote path for the encrypted archives, e.g. backup-remote:organized-backups
# Pick object storage in a DIFFERENT provider/region than this VPS.
BACKUP_DESTINATION=backup-remote:your-bucket
BACKUP_SCHEDULE_CRON=0 3 * * *

# rclone S3-compatible remote credentials (rendered into rclone.conf at startup).
RCLONE_S3_PROVIDER=Other
RCLONE_ACCESS_KEY_ID=
RCLONE_SECRET_ACCESS_KEY=
RCLONE_ENDPOINT=
RCLONE_REGION=auto
